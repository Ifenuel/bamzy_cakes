# ========================================
# BAMZY CAKES & CONFECTIONERY - BACKEND
# ========================================

# Server port
PORT=5000

# PostgreSQL database URL (from Supabase)
DATABASE_URL=postgresql://username:password@host:5432/bamzy_cakes

# JWT secret for authentication (64+ characters)
JWT_SECRET=your-random-64-character-secret-key-here

# Frontend URL (for CORS — change to your deployed Vercel URL)
CLIENT_URL=http://localhost:5173

# Paystack keys (get from paystack.com/dashboard → Settings → API Keys)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Paystack webhook URL (update after deploying backend)
PAYSTACK_WEBHOOK_URL=https://your-backend-url.railway.app/api/payments/webhook

# Node environment
NODE_ENV=development

# Brevo email service
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Bamzy Cakes & Confectionery

# Cloudinary image storage (images persist permanently)
# Get from: https://console.cloudinary.com → Account Details
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
