# ========================================
# BAMZY CAKES & CONFECTIONERY - BACKEND
# ========================================

# Server port
PORT=5000

# PostgreSQL database URL (from Supabase or your database provider)
DATABASE_URL=postgresql://username:password@host:5432/bamzy_cakes

# JWT secret for authentication (generate a long random string — 64+ characters)
# You can generate one at: https://www.random.org/strings/
JWT_SECRET=your-random-64-character-secret-key-here

# Frontend URL (for CORS — change to your deployed frontend URL in production)
CLIENT_URL=http://localhost:5173

# Paystack keys (get from paystack.com/dashboard → Settings → API Keys)
# Use sk_test_/pk_test_ for testing, sk_live_/pk_live_ for production
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Paystack webhook URL (update with your deployed backend URL + /api/payments/webhook)
PAYSTACK_WEBHOOK_URL=https://your-backend-url.railway.app/api/payments/webhook

# Image storage URL (base URL for uploaded images)
IMAGE_STORAGE_URL=http://localhost:5000

# Node environment (development | production)
NODE_ENV=development

# Brevo (Sendinblue) email service
# Get API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Bamzy Cakes & Confectionery
